OPENAI_API_KEY=PASTE_YOUR_KEY_HERE

# Subscription verification: configure server-side only, never in the iOS app.
MAKEUP_SUBSCRIPTIONS_ENABLED=0
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Enable for TestFlight/Sandbox. Production and Sandbox budgets are separate.
APPLE_ALLOW_SANDBOX=0
MAKEUP_SUBSCRIPTION_GLOBAL_DAILY_LIMIT=1000
# Keep this secret stable: rotation invalidates sessions and changes quota identities.
MAKEUP_VISITOR_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Invite-only beta testing. Empty disables all test sessions.
# SHA-256 of a random secret test code; never embed the plaintext in the app.
# One code shares 10 total attempts, expiring 7 days after its first redemption.
MAKEUP_TEST_CODE_SHA256=
